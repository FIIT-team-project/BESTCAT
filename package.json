{
  "name": "bestcat",
  "version": "2.0.0",
  "description": "BESTCAT exhibition management system powered by Payload CMS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "db:migrate": "pnpm payload migrate",
    "db:migrate:create": "pnpm payload migrate:create",
    "db:seed": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  }
}
