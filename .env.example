# Databázu prepínate výhradne cez DATABASE_URL.
# Táto hodnota smeruje na lokálnu DEV databázu z docker-compose.yml.
DATABASE_URL=postgresql://bestcat:bestcat_dev@localhost:5433/bestcat_dev
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10

# Účet, ktorý príkaz `pnpm db:seed` vloží do DEV databázy.
AUTH_EMAIL=admin@bestcat.sk
AUTH_PASSWORD=Bestcat123!
AUTH_NAME=Daniel Moore
AUTH_ROLE=Admin

# V produkcii musí mať aspoň 32 náhodných znakov.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
