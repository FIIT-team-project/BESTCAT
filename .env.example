DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public application origin used in password reset emails.
SERVER_URL=http://localhost:3000

SMTP_HOST=smtp.example.com
# For STARTTLS, use SMTP_PORT=587 and SMTP_SECURE=false.
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=BESTCAT

# Enable only behind a trusted proxy that overwrites X-Forwarded-For / X-Real-IP.
# Account and global OTP email limits also apply when this is false.
AUTH_TRUST_PROXY_IP=false
