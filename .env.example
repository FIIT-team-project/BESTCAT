# Databázu prepínate výhradne cez DATABASE_URL.
# Táto hodnota smeruje na lokálnu DEV databázu z docker-compose.yml.
DATABASE_URL=postgresql://bestcat:bestcat_dev@localhost:5433/bestcat_payload_dev
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10

# Payload CMS podpisuje prihlasovacie tokeny týmto kľúčom.
# V produkcii použite dlhú náhodnú hodnotu.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Účet, ktorý príkaz `pnpm db:seed` vloží do DEV databázy.
AUTH_EMAIL=admin@bestcat.sk
AUTH_PASSWORD=Bestcat123!
AUTH_NAME=Daniel Moore

# Seed vstupy. Relatívne cesty sa vyhodnocujú od koreňa projektu.
SEED_CATALOG_CSV_PATH=../judges(format 2).csv
SEED_CATALOG_PDF_PATH=../Catalog_20241228.pdf

PORT=3000
